SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_PATH=instance/roots_and_routes.sqlite3
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=ROOTS-AND-ROUTES/1.0
OSRM_BASE_URL=https://router.project-osrm.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
TRANSPORT_EMISSION_FACTORS_PATH=data/transport_emission_factors.csv
# Set a private, random key of at least 32 characters to enable provider administration.
COMMUNITY_ADMIN_KEY=
# Optional OpenAI-compatible assistant. Leave OPENAI_API_KEY blank for local rule-based mode.
OPENAI_API_KEY=
OPENAI_CHAT_COMPLETIONS_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini
